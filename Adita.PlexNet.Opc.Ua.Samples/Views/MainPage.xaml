<Page
    x:Class="Adita.PlexNet.Opc.Ua.Samples.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:ic="using:Microsoft.Xaml.Interactions.Core">

    <!--<i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Unloaded">
            <ic:InvokeCommandAction Command="{x:Bind ViewModel.DisposeCommand}"/>
        </ic:EventTriggerBehavior>
    </i:Interaction.Behaviors>-->

    <Grid x:Name="ContentArea">
        <StackPanel>
            <TextBlock Margin="0,0,0,10" Text="{x:Bind ViewModel.SubscriptionId, Mode=OneTime}"/>
            <NumberBox Value="{x:Bind ViewModel.Doublevalue, Mode=TwoWay}"/>
            <TextBlock Visibility="{x:Bind ViewModel.HasErrors, Mode=OneWay}" Text="HasError"/>
            <TextBlock Margin="0,10,0,0" Text="{x:Bind ViewModel.MonitoredItemsCount, Mode=OneWay}"/>
            <Button Command="{x:Bind ViewModel.GetMonitoredItemsCommand}">Get Monitored Items</Button>
        </StackPanel>
    </Grid>
</Page>
